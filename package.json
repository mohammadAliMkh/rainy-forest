{
  "name": "rainy-forest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "First-person rainy forest environment built with Three.js + Vite",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && node scripts/check-layers.mjs && node scripts/check-js-names.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
